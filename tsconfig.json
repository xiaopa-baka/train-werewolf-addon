{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "node",
        "allowJs": true,
        "checkJs": true,
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "noEmit": true,
        "types": [
            "@minecraft/server",
            "@minecraft/server-ui"
        ]
    },
    "include": [
        "BP/scripts/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "BP/scripts_backup_v1"
    ]
}