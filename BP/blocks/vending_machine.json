                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('lw_p1:part') == 'lower'",
                "components": {
                    "minecraft:geometry": {
                        "identifier": "geometry.vending_machine_lower"
                    },
                    "minecraft:collision_box": {
