                            -8
                        ],
                        "size": [
                            16,
                            16,
                            16
                        ]
                    },
                    "minecraft:placement_filter": {
                        "conditions": [
                            {
                                "block_filter": [
                                    "lw_p1:vending_machine"
                                ],
                                "allowed_faces": [
                                    "down"
