                            -8
                        ],
                        "size": [
                            16,
                            16,
                            16
                        ]
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            -8,
                            0,
                            -8
                        ],
                        "size": [
                            16,
                            16,
                            16
                        ]
                    },
                    "minecraft:loot": "loot_tables/empty.json",
                    "minecraft:placement_filter": {
                        "conditions": [
                            {
                                "block_filter": [
                                    "lw_p1:vending_machine"
                                ],
                                "allowed_faces": [
                                    "up"
                                ]
                            }
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('lw_p1:part') == 'carried'",
